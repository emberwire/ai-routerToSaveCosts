# ==============================================================================
# AI-Routed CLI Agent Configuration
# ==============================================================================

# Intent Classifier (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_THINKING_BUDGET=0

# Research / n8n Pipeline
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-prep
N8N_TIMEOUT_SECONDS=3.0
N8N_MAX_TOKENS=1500
ENABLE_N8N_PREP=true
ENABLE_LOCAL_SCRAPER_FALLBACK=true

# Execution Engines
DEFAULT_ENGINE=claude
CLAUDE_BINARY_PATH=/opt/homebrew/bin/claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CODEX_MODEL=o3-mini
GEMINI_EXEC_MODEL=gemini-2.5-pro

# Cloudflare AI Gateway (Optional)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=
CF_API_TOKEN=
ENABLE_CF_GATEWAY=false
CF_USE_UNIFIED_BILLING=false
CF_CACHE_TTL=3600

# Security & Compliance
ENABLE_DLP_SCANNER=true
ENABLE_PROMPT_INJECTION_QUARANTINE=true
ENABLE_AUDIT_LOGGING=true
OFFLINE_MODE=false
